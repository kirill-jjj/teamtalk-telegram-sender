#: bot/core/languages.py:48
msgid "language_native_name"
msgstr "Українська"

#: bot/core/notifications.py:129
#, python-brace-format
msgid "{user_nickname} joined server {server_name}"
msgstr "{user_nickname} приєднався до сервера {server_name}"

#: bot/core/notifications.py:131
#, python-brace-format
msgid "{user_nickname} left server {server_name}"
msgstr "{user_nickname} покинув сервер {server_name}"

#: bot/core/utils.py:26
msgid "<b>Available Commands:</b>"
msgstr "<b>Доступні команди:</b>"

#: bot/core/utils.py:29
msgid ""
"/who - Show online users.\n"
"/settings - Access the interactive settings menu (language, "
"notifications, mute lists, NOON feature).\n"
"/help - Show this help message.\n"
"(Note: `/start` is used to initiate the bot and process deeplinks.)"
msgstr ""
"/who - Показати користувачів онлайн.\n"
"/settings - Доступ до інтерактивного меню налаштувань (мова, сповіщення, "
"списки ігнорування, функція NOON).\n"
"/help - Показати це повідомлення.\n"
"(Примітка: `/start` використовується для ініціації бота та обробки "
"deeplink-посилань.)"

#: bot/core/utils.py:37
msgid ""
"\n"
"<b>Admin Commands:</b>"
msgstr ""
"\n"
"<b>Команди адміністратора:</b>"

#: bot/core/utils.py:40
msgid ""
"/kick - Kick a user from the server (via buttons).\n"
"/ban - Ban a user from the server (via buttons).\n"
"/unban - Unban a user from the server (shows a list of banned users).\n"
"/subscribers - View and manage subscribed users."
msgstr ""
"/kick - Виключити користувача з сервера (через кнопки).\n"
"/ban - Забанити користувача на сервері (через кнопки).\n"
"/unban - Розбанити користувача (показує список забанених).\n"
"/subscribers - Перегляд та керування підписниками."

#: bot/core/utils.py:47
msgid "Available commands:"
msgstr "Доступні команди:"

#: bot/core/utils.py:50
msgid ""
"/sub - Get a link to subscribe to notifications.\n"
"/unsub - Get a link to unsubscribe from notifications.\n"
"/help - Show help."
msgstr ""
"/sub - Отримати посилання для підписки на сповіщення.\n"
"/unsub - Отримати посилання для відписки від сповіщень.\n"
"/help - Показати довідку."

#: bot/core/utils.py:56
msgid ""
"\n"
"Admin commands (MAIN_ADMIN from config only):"
msgstr ""
"\n"
"Команди адміністратора (тільки для MAIN_ADMIN з конфігурації):"

#: bot/core/utils.py:59
msgid ""
"/add_admin <Telegram ID> [<Telegram ID>...] - Add bot admin.\n"
"/remove_admin <Telegram ID> [<Telegram ID>...] - Remove bot admin."
msgstr ""
"/add_admin <Telegram ID> [<Telegram ID>...] - Додати адміністратора бота."
"\n"
"/remove_admin <Telegram ID> [<Telegram ID>...] - Видалити адміністратора "
"бота."

