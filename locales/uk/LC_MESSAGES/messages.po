#: bot/core/notifications.py:141
#, python-brace-format
msgid "User {user_nickname} joined server {server_name}"
msgstr "👤 Користувач {user_nickname} приєднався до сервера {server_name}"

#: bot/core/notifications.py:143
#, python-brace-format
msgid "User {user_nickname} left server {server_name}"
